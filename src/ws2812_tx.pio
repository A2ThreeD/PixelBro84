;
; Standard 800 kHz WS2812 transmitter. One bit occupies ten PIO cycles.
.program ws2812_tx
.side_set 1

.define public T1 2
.define public T2 5
.define public T3 3

.wrap_target
bitloop:
    out x, 1        side 0 [T3 - 1]
    jmp !x do_zero side 1 [T1 - 1]
    jmp bitloop     side 1 [T2 - 1]
do_zero:
    nop             side 0 [T2 - 1]
.wrap
